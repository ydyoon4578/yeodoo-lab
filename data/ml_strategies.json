rs (and Losers)(2025) — 기대수익 대신 승자·패자 확률로 고르고, 확신이 없으면 베팅하지 않는 규칙이 거래비용 뒤에도 샤프를 올렸다는 보고다. 이 규칙의 값은 살 때가 아니라 안 살 때 나오므로, 방향 예측판과의 차이가 곧 '참는 것'의 값이다.","note":"특징: 12-1 모멘텀 · 1개월 반전 · 60일 변동성 · 200일선 이격도 · 50일선 이격도 · 거래량 추세 · 베타. 문턱 55%는 사전등록 값이고 결과를 보고 고치지 않았다. 문턱은 리밸런스 95회 중 80회 물었고(총 646종목 제외), 상위 10종목의 예측확률은 0.491~0.942 범위였다. 시장 방향을 맞혀도 횡단면 선택에는 소용이 없으므로 목표는 언제나 초과수익 기준이다. ⚠ 종목 패널이 3년뿐이라 학습창이 1년이다 — 머신러닝을 논하기에는 매우 짧은 표본이다.","start":"2018-08-06","end":"2026-07-24","n_days":2002,"metrics":{"cagr":29.38,"vol":62.4,"sharpe":0.67,"mdd":-86.07},"bench":{"cagr":17.5,"vol":20.22,"sharpe":0.717,"mdd":-38.16},"bench_unstable":false,"d_sharpe":-0.047,"t":1.4,"turnover":2.3,"nav":[100.0,100.0,100.0,97.58,98.48,87.58,80.0,77.05,76.84,75.16,74.6,74.6,76.44,79.72,81.5,81.5,81.5,81.5,81.5,81.82,82.24,84.43,86.47,89.31,89.62,97.97,103.71,106.22,104.0,102.13,101.91,96.81,94.24,98.1,99.91,105.19,105.19,103.7,112.39,118.98,118.31,118.31,122.41,122.79,106.64,56.08,65.32,83.95,89.64,109.75,109.75,116.04,129.09,132.66,141.92,141.92,143.66,154.0,157.63,158.33,157.7,161.25,158.19,156.41,164.07,210.88,210.88,210.88,242.42,263.22,264.03,286.67,301.8,323.14,295.59,302.25,307.32,339.7,330.79,346.41,392.85,417.36,404.51,402.98,439.56,380.77,393.33,391.93,436.64,417.57,417.57,417.57,417.57,398.94,425.09,456.17,486.42,506.96,545.58,512.72,507.36,519.93,601.04,581.0,581.0,466.2,329.85,301.78,245.13,231.6,226.58,226.58,226.58,226.58,226.58,226.58,226.58,217.4,196.01,135.11,128.16,118.9,118.9,118.9,118.9,118.9,118.9,118.9,118.9,118.9,118.9,111.81,104.9,102.74,104.99,104.59,104.59,104.59,104.59,104.59,94.35,87.29,114.79,117.13,102.66,97.98,90.48,103.78,100.44,126.03,161.74,166.62,166.62,166.62,228.02,223.94,281.73,281.73,273.57,235.22,257.31,295.95,296.73,281.57,272.73,270.78,301.5,274.97,235.3,258.89,214.5,232.3,248.54,308.09,358.0,408.63,400.78,444.19,464.83,420.17,465.05,465.94,465.37,392.1,318.04,373.51,332.07,346.07,403.0,403.0,403.0,403.0,403.0,403.0,403.0,403.0,418.05,453.78,485.78,516.11,564.