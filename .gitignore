__pycache__/

# DB 적재 로컬 로그(커밋 금지)
.dbload.log
.dbload.launchd.log

# 로컬 미리보기 설정(배포와 무관)
.claude/

# 잠금 페이지 평문 원본(커밋 절대 금지 — 커밋하면 암호화가 무의미해진다)
# validate_site.py가 평문 의존 검사에 사용. 일일잡의 dirty-tree 가드에도 걸리면 안 된다.
_build/

# 내비 생성 중간 산출물(build/sync_nav.py가 매번 다시 만든다 — 커밋하면 디프 노이즈만 는다)
build/nav_head.html
build/nav_body.html

# PIT 백테스트 로컬 입력 — 저장소에 두지 않는다.
#   pit_members.json   지수 편입 명단. 사내 DB(라이선스) 원천이라 커밋 금지(사용자 결정 2026-07-27).
#   _pit_px_cache.json 편출 종목 가격(yfinance). 재현 가능하지만 4MB라 로컬에만 둔다.
# 둘 다 없으면 build/pit_backtest.py 는 사내망 PC에서 한 번 다시 만들면 된다.
data/pit_members.json
data/_pit_px_cache.json
